# Copy to .env for local development (netlify dev) and set the same values
# in the Netlify UI (Site settings -> Environment variables) for production.

# Your Supabase project URL, e.g. https://xyzcompany.supabase.co
SUPABASE_URL=

# The public anon key (Dashboard -> Settings -> API). Safe to be semi-public;
# RLS policies are the authorization boundary.
SUPABASE_ANON_KEY=

# NOTE: the service-role key is intentionally NOT used by this app anymore.
# Do not add it here or to Netlify unless a future admin-only job needs it.
