    "dependencies": {
        "@sentry/node": "^10.75.1",
        "@supabase/supabase-js": "^2.112.4",
        "chart.js": "^4.5.1",
        "react": "^19.3.0",
        "react-dom": "^19.3.0"
    },
    "devDependencies": {
        "@axe-core/playwright": "^4.13.0",
        "@eslint/js": "^10.0.1",
        "@playwright/test": "^1.62.1",
